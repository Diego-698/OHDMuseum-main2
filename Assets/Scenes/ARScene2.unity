MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 795942653}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "This work titled Bistro in Paris is an exceptional one. It is world famous
    because it got the second prize at the Biennale in Venice in 1954. Affandi was
    at the time already in Europe. In '53, he painted this, and in '53, he was also
    participating in the Biennale of S\xE3o Paulo, and his works there attracted
    the curator of the Venice Biennale in '54. That's why he was invited to participate
    in the Biennale in '84 in Venice. He sent more than one painting, but this got
    the second prize, which was of course a big achievement. But Affandi was not
    happy. Affandi said, I should have got the first prize. And you know who got
    the first prize? It was the great surrealist Max Ernest. So I think second prize
    is already a very big achievement. But Afandi has a different perception. That's
    also what shows the greatness of Afandi\n\n\n\n\n\n\n\n\n\n\n\n"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_sharedMaterial: {fileID: 2180264, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_fontSharedMaterials: []
  m_fontMaterial: {fileID: 0}
  m_fontMaterials: []
  m_fontColor32:
    serializedVersion: 2
    rgba: 4284705131
  m_fontColor: {r: 0.42, g: 0.41, b: 0.39, a: 1}
  m_enableVertexGradient: 0
